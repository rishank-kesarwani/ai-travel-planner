# -----------------------------------------------------------------------------
# TravelPlanner AI Environment Variables
# -----------------------------------------------------------------------------

# Backend API URL (Production: https://ai-travel-planner-api.onrender.com or custom domain)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public Access Mode (true = allows anonymous trip generation & destination browsing; false = requires sign-in for all planning tools)
NEXT_PUBLIC_ACCESS_ENABLED=true

# -----------------------------------------------------------------------------
# 1. Google AdSense (Display Banners & Sponsored Units)
# -----------------------------------------------------------------------------
# Found in: Google AdSense Dashboard -> Ads -> By ad unit / Get Code
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# 2. Travelpayouts (All-in-One Affiliate Network - 100% Free)
# -----------------------------------------------------------------------------
# Sign up at: https://www.travelpayouts.com (Free)
# Found in: Travelpayouts Dashboard -> Top right corner "Marker / ID" (e.g., 579629)
# When set, all hotel, tour & flight clicks automatically earn commission!
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=579629

# -----------------------------------------------------------------------------
# 3. Optional: Individual Partner Direct IDs (Leave empty if using Travelpayouts)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
NEXT_PUBLIC_AGODA_AFFILIATE_ID=
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
NEXT_PUBLIC_VIATOR_AFFILIATE_ID=
NEXT_PUBLIC_KLOOK_AFFILIATE_ID=
