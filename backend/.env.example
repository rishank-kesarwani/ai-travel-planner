# Application Configuration
NODE_ENV=production
PORT=4000
APP_NAME=ai-travel-planner
APPLICATION_ID=ai-travel-planner
FRONTEND_URL=https://travel-planner.rishankkesarwani.com

# Security & JWT
JWT_ACCESS_SECRET=your_jwt_access_super_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_super_secret_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SERVICE_API_KEY=travel_planner_internal_service_key_99182

# Database (MongoDB Atlas / Railway / Hosted MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-travel-planner?retryWrites=true&w=majority

# Cache & Message Queue (Redis - Railway Redis URL or Host/Port)
# If using Railway Redis or cloud Redis URL:
REDIS_URL=redis://default:password@railway-redis.railway.internal:6379
# Alternatively, host/port breakdown:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Platform Integration (Replaces direct LLM/RAG calls)
AI_PLATFORM_URL=http://localhost:5000
AI_PLATFORM_API_KEY=platform_master_key_dev_12345
AI_PLATFORM_TIMEOUT_MS=60000

# Notification Engine Integration (Dual-Channel Email & Push)
NOTIFICATION_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_API_KEY=test-api-key-12345

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Public Access Configuration (Optional Authentication for Public Planning)
PUBLIC_ACCESS_ENABLED=true
